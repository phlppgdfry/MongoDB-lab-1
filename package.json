{
  "name": "mongodb-atlas-ollama-agent-demo",
  "version": "1.0.0",
  "description": "A MongoDB Atlas and local Ollama RAG showcase with a TypeScript API and web UI.",
  "author": "Philippe Godfroy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phlppgdfry/MongoDB-lab-1.git"
  },
  "keywords": [
    "mongodb",
    "mongodb-atlas",
    "ollama",
    "rag",
    "local-ai",
    "typescript",
    "nodejs",
    "retrieval-augmented-generation"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test": "node --import tsx --test test/*.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mongodb": "^6.12.0",
    "ollama": "^0.5.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
